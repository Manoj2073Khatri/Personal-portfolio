# Copy to .env.local for local development. Never commit real values.
# Full reference: docs/environment.md

# Server-only: CMS API base URL including the version prefix
CMS_API_URL=http://localhost:4000/api/v1
# Server-only: must equal the backend INTERNAL_API_KEY
INTERNAL_API_KEY=
# Public canonical origin used for metadata, sitemap, RSS and JSON-LD
NEXT_PUBLIC_SITE_URL=http://localhost:3000
