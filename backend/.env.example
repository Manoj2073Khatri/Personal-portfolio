# Copy to .env.local for local development. Never commit real values.
# Full reference: docs/environment.md

PORT=4000
# Local Postgres from docker-compose.yml (port 5433)
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5433/portfolio

# Generate each with: openssl rand -hex 32  (must differ, >= 32 chars)
JWT_SECRET=
JWT_REFRESH_SECRET=
# Salt for hashing contact-form IPs (required in production)
IP_HASH_SALT=
# Shared with the frontend server; enables per-visitor rate limiting (>= 32 chars)
INTERNAL_API_KEY=

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
# Number of reverse-proxy hops to trust for req.ip (0 = none)
TRUST_PROXY=0
SWAGGER_ENABLED=true

# Media storage (optional locally; uploads return 503 until set)
AWS_REGION=
S3_BUCKET=
# Public base URL for objects, e.g. a CloudFront domain
S3_PUBLIC_BASE_URL=
# Only for S3-compatible storage such as MinIO or LocalStack
S3_ENDPOINT=
# Credentials come from the AWS default chain (env vars or IAM role):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# E2E tests only (database name must contain "test")
# TEST_DATABASE_URL=postgresql://portfolio:portfolio@localhost:5433/portfolio_test
